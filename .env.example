# Generate a separate random service key. Never commit the real .env.
SERVICE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
STORE_PATH=/absolute/path/to/grounded-rag-service/data/chroma
SNAPSHOT_NAME=guide-v1
# Copy this from `python rag_cli.py inspect ...` after operator review.
EXPECTED_HIERARCHY_SHA256=
DIMENSIONS=512
MAX_CONCURRENT=2
REQUESTS_PER_MINUTE=30
RESPONSE_DEADLINE_SECONDS=30
BODY_TIMEOUT_SECONDS=5
MAX_BODY_BYTES=8192
MAX_MODEL_CALLS=3
MAX_EMBEDDING_CALLS=8
COMPRESS_PARENTS=true
